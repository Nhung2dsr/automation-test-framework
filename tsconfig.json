{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "noEmit": true,

    "resolveJsonModule": true,
    "skipLibCheck": true,

    "noUncheckedIndexedAccess": true,

    "types": ["node"]
  },

  "include": [
    "src/**/*.ts",
    "fixtures/**/*.ts",
    "tests/**/*.ts",
    "config/**/*.ts",
    "playwright.config.ts"
  ],

  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results"
  ]
}